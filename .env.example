# ---------------------------------------------------------------------------
# ADAPT — Adaptive AI Finance Controller
# Copy this file to `.env` and adjust values.
# Everything below runs locally and free — no paid APIs, no OpenAI.
# ---------------------------------------------------------------------------

# Prisma + SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Ollama local AI server (https://ollama.com — runs on your machine)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# qwen2.5:1.5b is the smallest model that reliably handles this task.
# Switch to llama3.1:8b only if you have a GPU or need higher accuracy.
OLLAMA_MODEL="qwen2.5:1.5b"

# How long (ms) to wait for the local model before timing out a judgment
OLLAMA_TIMEOUT_MS="20000"

# Groq API — Agent 2 / Challenge Analyst (optional)
# Leave GROQ_API_KEY empty to disable dual-agent mode.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_TIMEOUT_MS="30000"