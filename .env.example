# ---------------------------------------------------------------------------
# ADAPT — Adaptive AI Finance Controller
# Copy this file to `.env` and adjust values.
# Everything below runs locally and free — no paid APIs, no OpenAI.
# ---------------------------------------------------------------------------

# Prisma + SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Ollama local AI server (https://ollama.com — runs on your machine)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# How long (ms) to wait for the local model before timing out a judgment
OLLAMA_TIMEOUT_MS="60000"